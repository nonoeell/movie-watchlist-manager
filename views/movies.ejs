<%- include('partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h1 class="h2 mb-1">My Watchlist</h1>
    <p class="text-muted mb-0">View, filter, edit, and remove saved movies.</p>
  </div>
  <a href="/movies/add" class="btn btn-warning">Add Movie</a>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <form action="/movies" method="GET" class="row g-3">
      <div class="col-md-5">
        <label class="form-label">Filter by Genre</label>
        <select name="genre" class="form-select">
          <option value="">All Genres</option>
          <% genres.forEach(genre => { %>
            <option value="<%= genre %>" <%= genreFilter === genre ? 'selected' : '' %>><%= genre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-5">
        <label class="form-label">Filter by Status</label>
        <select name="status" class="form-select">
          <option value="">All Status</option>
          <option value="Planned" <%= statusFilter === 'Planned' ? 'selected' : '' %>>Planned</option>
          <option value="Watched" <%= statusFilter === 'Watched' ? 'selected' : '' %>>Watched</option>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-dark w-100">Apply</button>
      </div>
    </form>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Year</th>
            <th>Rating</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (movies.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-4">No movies found.</td>
            </tr>
          <% } %>
          <% movies.forEach(movie => { %>
            <tr>
              <td><%= movie.title %></td>
              <td><%= movie.genre %></td>
              <td><%= movie.year %></td>
              <td><%= movie.rating %> / 5</td>
              <td><span class="badge text-bg-secondary"><%= movie.status %></span></td>
              <td>
                <a href="/movies/<%= movie.id %>" class="btn btn-sm btn-outline-dark">View</a>
                <a href="/movies/edit/<%= movie.id %>" class="btn btn-sm btn-outline-primary">Edit</a>
                <form action="/movies/delete/<%= movie.id %>" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>