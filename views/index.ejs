<%- include('partials/header') %>

<div class="hero-section p-5 mb-4 rounded-4 shadow-sm">
  <div class="row align-items-center g-4">
    <div class="col-lg-8">
      <h1 class="display-6 fw-bold mb-3">Track movies you want to watch</h1>
      <p class="lead mb-4">Keep your watchlist organized, update movie details, and review what you have already watched.</p>
      <a href="/movies/add" class="btn btn-warning btn-lg me-2">Add New Movie</a>
      <a href="/movies" class="btn btn-outline-light btn-lg">View Watchlist</a>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 stat-card">
        <div class="card-body">
          <h5 class="card-title">Quick Summary</h5>
          <p class="mb-2">Total movies: <strong><%= stats.total %></strong></p>
          <p class="mb-2">Watched: <strong><%= stats.watched %></strong></p>
          <p class="mb-0">Planned: <strong><%= stats.planned %></strong></p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-12">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <h2 class="h4 mb-3">Recent Movies</h2>
        <div class="row g-3">
          <% recentMovies.forEach(movie => { %>
            <div class="col-md-4">
              <div class="movie-card p-3 rounded-3 h-100">
                <h3 class="h5"><%= movie.title %></h3>
                <p class="text-muted mb-1"><%= movie.genre %> • <%= movie.year %></p>
                <p class="mb-2">Status: <span class="badge text-bg-secondary"><%= movie.status %></span></p>
                <a href="/movies/<%= movie.id %>" class="btn btn-sm btn-dark">View Details</a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>